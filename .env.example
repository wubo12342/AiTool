# --- 資料庫設定 ---
# 如果使用 Docker, DB_HOST 請填 db
# 如果使用 XAMPP, DB_HOST 請填 localhost
DB_HOST=db
DB_NAME=ai_tools
DB_USER=root
DB_PASS=root

# --- JWT 簽章金鑰 ---
# 請改成至少 32 字元的隨機字串。範例：php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=please_replace_me_with_a_long_random_string

# --- OpenAI 設定 ---
# 請在此填入您的 API Key
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o

# --- 其他設定 ---
VITE_API_URL=http://localhost:8081/api
